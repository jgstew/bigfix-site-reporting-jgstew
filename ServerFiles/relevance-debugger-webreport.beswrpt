<?xml version="1.0" encoding="UTF-8"?>
<BESWebReport>
	<Name>Relevance Debugger</Name>
	<Description></Description>
	<Type>CustomReport</Type>
	<Source>JGStew</Source>
	<Data><![CDATA[
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta charset="utf-8" />
<style>
  #rdbg { font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif; font-size: 13px; line-height: 1.45; color: #1f2328; background: #fff; padding: 14px 18px 24px 18px; max-width: 1200px; }
  #rdbg * { box-sizing: border-box; }
  #rdbg .header { border-bottom: 1px solid #d0d7de; padding-bottom: 10px; margin-bottom: 14px; }
  #rdbg h1 { font-size: 20px; font-weight: 600; margin: 0; color: #0b3d91; }
  #rdbg h1 .tag { font-size: 11px; font-weight: 600; color: #57606a; border: 1px solid #d0d7de; border-radius: 10px; padding: 1px 8px; margin-left: 8px; vertical-align: middle; }
  #rdbg .subtitle { color: #57606a; margin: 2px 0 0 0; }
  #rdbg h2 { font-size: 14px; font-weight: 600; margin: 0 0 8px 0; }
  #rdbg .panel { border: 1px solid #d0d7de; border-radius: 6px; padding: 12px 14px; margin: 0 0 14px 0; background: #fff; }
  #rdbg .hint { color: #57606a; }
  #rdbg .error { color: #b42318; }
  #rdbg .ok { color: #1a7f37; }
  #rdbg .notice { border-left: 3px solid #bf8700; background: #fff8e5; padding: 6px 10px; margin: 8px 0 0 0; }
  #rdbg .notice.info { border-left-color: #0969da; background: #f0f6ff; }
  #rdbg .notice:empty { display: none; }
  #rdbg label { white-space: nowrap; }
  #rdbg textarea, #rdbg input[type=text], #rdbg input[type=number], #rdbg select { font-family: inherit; font-size: 13px; border: 1px solid #afb8c1; border-radius: 4px; padding: 3px 6px; background: #fff; color: #1f2328; }
  #rdbg textarea.query { width: 100%; height: 110px; font-family: Consolas, "SF Mono", Menlo, monospace; padding: 6px 8px; resize: vertical; }
  #rdbg #editorHost .cm-editor { border: 1px solid #afb8c1; border-radius: 4px; min-height: 110px; font-size: 13px; }
  #rdbg #editorHost .cm-editor.cm-focused { outline: 2px solid #0969da; outline-offset: -1px; }
  #rdbg input[type=number] { width: 58px; }
  #rdbg #ids { width: 200px; }
  #rdbg .row { margin: 10px 0 0 0; }
  #rdbg .row label { margin-right: 16px; display: inline-block; margin-bottom: 4px; }
  #rdbg .row .why { margin-left: 4px; }
  #rdbg .targets { margin: 10px 0 0 0; padding: 8px 10px; background: #f6f8fa; border-radius: 4px; }
  #rdbg .targets .title { font-weight: 600; margin-right: 12px; }
  #rdbg .actions { margin: 12px 0 0 0; }
  #rdbg button { font-family: inherit; font-size: 13px; padding: 5px 16px; border-radius: 4px; border: 1px solid #afb8c1; background: #f6f8fa; color: #1f2328; cursor: pointer; margin-right: 8px; }
  #rdbg button:hover { background: #eef1f4; }
  #rdbg button.primary { background: #0b5cd5; border-color: #0a4fb7; color: #fff; font-weight: 600; }
  #rdbg button.primary:hover { background: #0a4fb7; }
  #rdbg button[disabled] { opacity: 0.5; cursor: default; }
  #rdbg button.small { padding: 2px 10px; font-size: 12px; }
  #rdbg #status { color: #57606a; }
  #rdbg table { border-collapse: collapse; width: 100%; }
  #rdbg th, #rdbg td { border-bottom: 1px solid #d8dee4; padding: 5px 8px; text-align: left; vertical-align: top; }
  #rdbg th { background: #f6f8fa; font-weight: 600; border-top: 1px solid #d8dee4; }
  #rdbg tbody tr:hover td { background: #f6f8fa; }
  #rdbg td.answer, #rdbg ol.answers { font-family: Consolas, "SF Mono", Menlo, monospace; white-space: pre-wrap; word-break: break-word; }
  #rdbg td.error { color: #b42318; }
  #rdbg td.empty { color: #57606a; font-style: italic; text-align: center; padding: 14px; }
  #rdbg ol.answers { margin: 6px 0 0 0; padding-left: 36px; }
  #rdbg ol.answers li { padding: 1px 0; }
  #rdbg .summary { font-weight: 600; margin: 0; }
  #rdbg .errbox { border: 1px solid #f1aeb5; background: #fff1f0; color: #8c1d18; border-radius: 4px; padding: 8px 10px; margin: 6px 0 0 0; font-family: Consolas, "SF Mono", Menlo, monospace; white-space: pre-wrap; }
  #rdbg .badge { display: inline-block; border-radius: 10px; padding: 1px 9px; margin: 0 6px 4px 0; font-size: 12px; border: 1px solid #d0d7de; background: #f6f8fa; }
  #rdbg .badge.ok { border-color: #a6dbb4; background: #edf9f0; color: #1a7f37; }
  #rdbg .badge.error { border-color: #f1aeb5; background: #fff1f0; color: #b42318; }
  #rdbg details { display: block; margin: 0 0 14px 0; border: 1px solid #d0d7de; border-radius: 6px; padding: 8px 14px; }
  #rdbg summary { cursor: pointer; font-weight: 600; color: #57606a; display: block; }
  #rdbg.no-details summary:before { content: "\25B8\00a0\00a0"; }
  #rdbg.no-details details[open] summary:before { content: "\25BE\00a0\00a0"; }
  #rdbg details h3 { font-size: 13px; margin: 12px 0 4px 0; }
  #rdbg #log, #rdbg #diagText { width: 100%; font-family: Consolas, "SF Mono", Menlo, monospace; font-size: 12px; background: #f6f8fa; }
  #rdbg #log { height: 130px; }
  #rdbg #diagText { height: 190px; }
  #rdbg .footer { color: #8c959f; font-size: 11px; margin-top: 8px; }
</style>
<div id="rdbg">
  <div class="header">
    <h1>Relevance Debugger<span class="tag">proof of concept</span></h1>
    <p class="subtitle" data-only="console">Evaluate client relevance on this computer and with FastQuery, and session relevance on this deployment.</p>
    <p class="subtitle" data-only="webreport">Check relevance with the analyzer and evaluate it as session relevance. Client relevance can be analyzed here, not evaluated.</p>
    <p id="hostNotice" class="notice"></p>
  </div>

  <div class="panel">
    <div id="editorHost" data-only="webreport"></div>
    <textarea id="rel" class="query" spellcheck="false" aria-label="Relevance statement">number of bes computers</textarea>

    <div data-only="console">
      <div class="row">
        <label>Run as
          <select id="dialect">
            <option value="auto" selected="selected">Auto</option>
            <option value="session">Session relevance</option>
            <option value="client">Client relevance</option>
            <option value="both">Both</option>
          </select>
        </label>
        <span id="dialectWhy" class="hint why"></span>
      </div>
      <div class="targets">
        <span class="title">Client targets</span>
        <label><input type="checkbox" id="useLocal" checked="checked" /> This computer (qna)</label>
        <label><input type="checkbox" id="useFast" checked="checked" /> FastQuery:
          <input type="number" id="fastCount" value="5" min="1" max="100" /> random computers that reported in the last hour</label>
        <label>or computer IDs <input type="text" id="ids" placeholder="e.g. 1234, 5678" /></label>
        <label>timeout <input type="number" id="timeoutSec" value="90" min="5" max="600" /> s</label>
        <div id="clientWhy" class="hint"></div>
      </div>
    </div>

    <div class="actions">
      <button id="evaluate" class="primary">Evaluate</button>
      <button id="cancel" disabled="disabled" data-only="console">Cancel</button>
      <span id="status"></span>
    </div>
    <p id="dialectNote" class="notice info" data-only="webreport"></p>
  </div>

  <div class="panel" data-only="webreport">
    <h2>Analysis</h2>
    <div id="analysis" class="hint">The analyzer is loading&hellip;</div>
  </div>

  <div class="panel">
    <h2>Results</h2>
    <div data-only="webreport">
      <div id="wrResult" class="hint">Evaluate to see the answers.</div>
    </div>
    <table id="results" data-only="console">
      <thead><tr><th>Dialect</th><th>Source</th><th>Computer</th><th>Answers</th><th>Error</th><th>Details</th></tr></thead>
      <tbody><tr><td class="empty" colspan="6">Evaluate to see the answers.</td></tr></tbody>
    </table>
  </div>

  <details>
    <summary>Log and diagnostics</summary>
    <h3>Log</h3>
    <textarea id="log" readonly="readonly"></textarea>
    <h3>Diagnostics <button id="copyDiag" class="small">Copy</button></h3>
    <p class="hint">What this page found about where it is running. Include it when reporting a problem.</p>
    <textarea id="diagText" readonly="readonly"></textarea>
    <div data-only="webreport">
      <h3>Analyzer <button id="reloadAnalyzer" class="small">Reload the analyzer</button></h3>
      <p class="hint">If the analyzer does not load or misbehaves: forgets the copy this browser keeps (and any note that it does not start here), then downloads and starts it again.</p>
    </div>
  </details>
  <p id="footer" class="footer"></p>
</div>

<script>
window.RDBG_BUILD = {"target": "webreport", "built": "2026-10-20T13:10Z", "analyzer": true, "analyzerUrls": ["https://www.jgstew.com/files/analyzer/manifest.json", "https://www.jgstew.com/files/bigfix-relevance-analyzer-playground.html"]};
</script>
<script>
/*
 * Relevance debugger dashboard, proof of concept: the core layer, shared by
 * the console and Web Reports builds (RDBG_BUILD.target). See README.md.
 *
 * ES5 ONLY. The BigFix console renders dashboards in its IE11 engine, where
 * one `let`, arrow function or template string is a syntax error that stops
 * this whole script. The analyzer exists only in the Web Reports build; it
 * loads separately and calls rdbg.onAnalyzer.
 *
 * Host functions used, as the older dashboards in jgstew/bigfix-content and
 * jgstew/C3-Query-Dashboard call them (none are documented, so shapes are
 * logged to the diagnostics panel):
 *   Relevance(q, {success, failure})   console session relevance, async
 *   EvaluateRelevance(q)               session relevance, sync (Web Reports)
 *   API.Post(path, body, cb) / API.Get(path, cb), cb(error, status, body)
 *   ActiveXObject                      IE engine only: runs the local qna
 */
(function () {
  "use strict";

  var SESSION_TARGETS = "ids of bes computers whose (last report time of it > now - 1 * hour)";
  var DELIM = "<~rdbg~>";
  var MAX_SHOWN = 200;
  // The Web Report fetches the analyzer after the page loads (analyzer_loader.html).
  var LOADING_NOTE = "loading (the first time downloads about 12 MB; after that it is cached in this browser)";
  // FastQuery polling backs off while waiting: the first check comes
  // POLL_FIRST_MS after the last, each gap grows by POLL_GROWTH up to
  // POLL_MAX_MS, and the last check lands on the timeout. Answers that have
  // not come in early are less likely to come in at all.
  var POLL_FIRST_MS = 2000;
  var POLL_GROWTH = 1.5;
  var POLL_MAX_MS = 15000;
  // How long past its timeout FastQuery waits for a REST reply that never came.
  var REPLY_MARGIN_MS = 5000;

  var host = null;
  var analyzer = null; // set by rdbg.onAnalyzer
  var analyzerNote = "not loaded yet";
  var editor = null; // {getText} once the analyzer mounts CodeMirror
  var analyzerReload = null; // set by rdbg.setAnalyzerReload (webreport loader)
  // True from the start of a load (or Reload) until onAnalyzer or
  // onAnalyzerFailed; Reload the analyzer is disabled meanwhile.
  var analyzerPending = false;
  var loadAttempt = 0; // which load the 5-minute watchdog is for
  // The evaluation in progress, {cancelled, cancels: [fn]}. Each run's
  // callbacks hold their own one, so an abandoned run's late replies are
  // dropped rather than landing in the next run's results.
  var run = null;
  var facts = {}; // diagnostics, in insertion order via factOrder
  var factOrder = [];

  function $(id) {
    return document.getElementById(id);
  }

  function now() {
    return new Date().getTime();
  }

  function pad(n) {
    return n < 10 ? "0" + n : String(n);
  }

  function log(text) {
    var d = new Date();
    var stamp = pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());
    var box = $("log");
    box.value += stamp + "  " + text + "\n";
    box.scrollTop = box.scrollHeight;
  }

  function setText(id, text, cls) {
    var node = $(id);
    node.innerHTML = "";
    node.appendChild(document.createTextNode(text));
    if (cls !== undefined) node.className = cls;
  }

  function errText(e) {
    if (e === null || e === undefined) return "unknown error";
    if (typeof e === "string") return e;
    return e.message || e.description || e.Message || String(e);
  }

  function fact(name, value) {
    if (!(name in facts)) factOrder.push(name);
    facts[name] = value;
    var lines = [];
    for (var i = 0; i < factOrder.length; i++) lines.push(factOrder[i] + ": " + facts[factOrder[i]]);
    $("diagText").value = lines.join("\n");
  }

  // Describe a host return value without assuming its shape.
  function shapeOf(value) {
    if (value === null) return "null";
    var t = typeof value;
    if (t !== "object") return t + (t === "string" ? " (length " + value.length + ")" : "");
    var keys = [];
    try {
      for (var k in value) {
        keys.push(k);
        if (keys.length > 8) break;
      }
    } catch (e) {}
    var first = keys.length ? " first item " + typeof value[keys[0]] : "";
    var kind = Object.prototype.toString.call(value); // "[object Date]", ...
    return kind + " keys [" + keys.join(", ") + "]" + first;
  }

  // A host result as a list of strings: an array, an object keyed "0".."n"
  // (the console's async Relevance), or a single value.
  function toList(value) {
    var out = [];
    if (value === null || value === undefined) return out;
    // A COM SAFEARRAY from the IE engine's host reports typeof "unknown".
    if (typeof value === "unknown" && typeof window.VBArray !== "undefined") {
      try {
        value = new window.VBArray(value).toArray();
      } catch (e) {}
    }
    if (value instanceof Array) {
      for (var i = 0; i < value.length; i++) out.push(String(value[i]));
      return out;
    }
    if (typeof value === "object") {
      for (var n = 0; String(n) in value; n++) out.push(String(value[String(n)]));
      if (out.length) return out;
      if (value instanceof Date) return [String(value)];
      // Anything else with no items, e.g. Web Reports' {} for an empty
      // result, is no answers.
      if (!("length" in value)) return out;
      for (var j = 0; j < value.length; j++) out.push(String(value[j]));
      return out;
    }
    return [String(value)];
  }

  // ---- load timings ----------------------------------------------------------

  // Milliseconds since the browser started the page request, or null where
  // the Navigation Timing API is missing (it exists in IE11).
  function sinceStart() {
    try {
      var t = window.performance.timing;
      return t.navigationStart ? now() - t.navigationStart : null;
    } catch (e) {
      return null;
    }
  }

  function seconds(ms) {
    return ms === null || ms === undefined || ms < 0 ? "?" : (ms / 1000).toFixed(2) + " s";
  }

  // Where the time goes before the page is usable: the server (request to
  // first byte: for a Web Report, its server-side processing), the download,
  // then the browser parsing it. Recorded once the load event has finished.
  function loadTimings() {
    var t;
    try {
      t = window.performance.timing;
    } catch (e) {
      return;
    }
    if (!t || !t.navigationStart) {
      fact("load timings", "not available in this browser");
      return;
    }
    var start = t.navigationStart;
    fact("time to first byte (server)", seconds(t.responseStart - (t.requestStart || start)));
    fact("download", seconds(t.responseEnd - t.responseStart));
    fact("DOM ready", seconds(t.domContentLoadedEventStart - start) + " after the request started");
    fact("page load", seconds(t.loadEventStart - start) + " after the request started");
    try {
      var nav = window.performance.getEntriesByType("navigation")[0];
      if (nav && nav.transferSize) {
        fact("transferred", Math.round(nav.transferSize / 1024) + " KB (" + Math.round(nav.decodedBodySize / 1024) + " KB decoded)");
      }
    } catch (e) {}
  }

  function hasGlobal(name) {
    try {
      return typeof window[name] !== "undefined" && window[name] !== null;
    } catch (e) {
      return false;
    }
  }

  function detectHost() {
    var h = {
      relevanceAsync: hasGlobal("Relevance"),
      relevanceSync: hasGlobal("EvaluateRelevance"),
      api: false,
      activeX: false,
      webReports: null,
    };
    try {
      h.api = !!(window.API && window.API.Post && window.API.Get);
    } catch (e) {}
    try {
      h.activeX = typeof window.ActiveXObject !== "undefined" || "ActiveXObject" in window;
    } catch (e) {}
    h.session = h.relevanceAsync || h.relevanceSync;
    return h;
  }

  function hostKind() {
    if (host.api) return "console";
    if (host.webReports === true) return "webreports";
    if (host.session) return host.webReports === false ? "console" : "webreports?";
    return "none";
  }

  // ---- session relevance -------------------------------------------------

  // One host call, async Relevance() if there is one, else sync
  // EvaluateRelevance(); cb(error, rawValue).
  function callHost(query, tag, cb) {
    if (host.relevanceAsync) {
      try {
        window.Relevance(query, {
          success: function (res) {
            fact("Relevance() success shape, " + tag, shapeOf(res));
            cb(null, res);
          },
          failure: function (e) {
            fact("Relevance() failure shape, " + tag, shapeOf(e) + ": " + errText(e).slice(0, 200));
            cb(errText(e));
          },
        });
      } catch (e) {
        cb("Relevance() threw: " + errText(e));
      }
      return;
    }
    if (host.relevanceSync) {
      var res;
      try {
        res = window.EvaluateRelevance(query);
      } catch (e) {
        fact("EvaluateRelevance() error, " + tag, errText(e).slice(0, 200));
        cb(errText(e));
        return;
      }
      fact("EvaluateRelevance() shape, " + tag, shapeOf(res));
      cb(null, res);
      return;
    }
    cb("no session relevance function on this page");
  }

  // done(error, answers, info). The host hands back native values (a boolean,
  // a Date for a time), so the answers are cast to strings in relevance and
  // joined into one string. Types with no string cast fail that, so the query
  // then runs as written: its answers are the host's values, and its error, if
  // any, is the query's own.
  function evalSession(query, done, label) {
    // Keyed by the query text, so a series of test queries adds up in the
    // diagnostics instead of each replacing the last.
    var shortQuery = query.replace(/\s+/g, " ");
    if (shortQuery.length > 60) shortQuery = shortQuery.slice(0, 57) + "...";
    var tag = label || '"' + shortQuery + '"';
    var started = now();
    var finished = false;
    function finish(err, answers, info) {
      if (finished) return;
      finished = true;
      clearTimeout(watchdog);
      done(err, answers || [], (info ? info + ", " : "") + (now() - started) + " ms");
    }
    var watchdog = setTimeout(function () {
      finish("no reply from the console within 120 s");
    }, 120000);
    var mode = host.relevanceAsync ? "async" : "sync";

    var wrapped = 'concatenation "' + DELIM + '" of ((it as string) of (' + query + "))";
    callHost(wrapped, tag + " as strings", function (err, res) {
      if (!err) {
        var text = toList(res).join(DELIM);
        finish(null, text === "" ? [] : text.split(DELIM), mode);
        return;
      }
      callHost(query, tag, function (err2, res2) {
        if (err2) finish(err2, [], mode);
        // Web Reports hands back "" for no answers.
        else finish(null, res2 === "" ? [] : toList(res2), mode + ", host values (no string cast: " + err + ")");
      });
    });
  }

  // ---- client relevance on this machine (IE engine, ActiveX) -------------

  function findQna(fso, shell) {
    var dirs = [];
    var keys = [
      "HKLM\\SOFTWARE\\WOW6432Node\\BigFix\\EnterpriseClient\\EnterpriseClientFolder",
      "HKLM\\SOFTWARE\\BigFix\\EnterpriseClient\\EnterpriseClientFolder",
    ];
    for (var i = 0; i < keys.length; i++) {
      try {
        dirs.push(shell.RegRead(keys[i]));
      } catch (e) {}
    }
    dirs.push("C:\\Program Files (x86)\\BigFix Enterprise\\BES Client");
    dirs.push("C:\\Program Files\\BigFix Enterprise\\BES Client");
    for (var j = 0; j < dirs.length; j++) {
      var path = String(dirs[j]).replace(/\\+$/, "") + "\\qna.exe";
      if (fso.FileExists(path)) return path;
    }
    return null;
  }

  function parseQna(text) {
    var out = { answers: [], errors: [], times: [], types: [] };
    var lines = text.split(/\r?\n/);
    var last = null; // the tag of the previous line, for continuation lines
    for (var i = 0; i < lines.length; i++) {
      // With stdin redirected, qna's "Q: " prompt is not followed by a newline,
      // so it prefixes the next output line ("Q: A: ...").
      var prompted = /^Q:/.test(lines[i]);
      var m = /^([AETI]): ?(.*)$/.exec(lines[i].replace(/^(Q: ?)+/, ""));
      if (!m) {
        // A line with no tag and no prompt continues a multi-line answer.
        if (!prompted && last === "A" && lines[i] !== "") {
          out.answers[out.answers.length - 1] += "\n" + lines[i];
        } else {
          last = null;
        }
        continue;
      }
      last = m[1];
      if (m[1] === "A") out.answers.push(m[2]);
      else if (m[1] === "E") out.errors.push(m[2]);
      else if (m[1] === "T") out.times.push(m[2]);
      else out.types.push(m[2]);
    }
    return out;
  }

  // The relevance goes into a temp file and reaches qna on stdin, never on a
  // command line, so cmd metacharacters in it are harmless. Output goes to a
  // file too, so a large answer cannot fill the pipe and stall qna.
  function evalLocal(ctx, query, timeoutMs, done) {
    var fso, shell, exec, inFile, outFile;
    try {
      fso = new window.ActiveXObject("Scripting.FileSystemObject");
      shell = new window.ActiveXObject("WScript.Shell");
    } catch (e) {
      done("ActiveX blocked: " + errText(e));
      return;
    }
    var qna = findQna(fso, shell);
    fact("qna path", qna || "not found");
    if (!qna) {
      done("qna.exe not found (no BigFix client on this machine?)");
      return;
    }
    // qna reads one query per line.
    var oneLine = query.replace(/\s*[\r\n]+\s*/g, " ");
    var base = fso.GetSpecialFolder(2).Path + "\\" + fso.GetTempName();
    inFile = base + ".qna";
    outFile = base + ".out";
    var f = null;
    try {
      f = fso.CreateTextFile(inFile, true, false);
      f.WriteLine(oneLine);
      f.Close();
      f = null;
    } catch (e) {
      // An ANSI text file cannot hold characters outside the code page.
      try {
        if (f) f.Close();
      } catch (e2) {}
      cleanup();
      done("could not write the relevance for qna (characters outside this computer's code page?): " + errText(e));
      return;
    }
    try {
      exec = shell.Exec('cmd.exe /c ""' + qna + '" -t -showtypes < "' + inFile + '" > "' + outFile + '" 2>&1"');
    } catch (e) {
      cleanup();
      done("could not start qna: " + errText(e));
      return;
    }
    var started = now();
    // Terminate() would end only cmd.exe and leave qna.exe running (and its
    // temp files open), so end the whole tree, then clean up.
    function stop() {
      try {
        shell.Run("taskkill /F /T /PID " + exec.ProcessID, 0, true);
      } catch (e) {
        try {
          exec.Terminate();
        } catch (e2) {}
      }
      cleanup();
    }
    function cleanup() {
      try {
        fso.DeleteFile(inFile, true);
      } catch (e) {}
      try {
        fso.DeleteFile(outFile, true);
      } catch (e) {}
    }
    ctx.cancels.push(stop);
    function poll() {
      if (ctx.cancelled) return;
      if (exec.Status === 0) {
        if (now() - started > timeoutMs) {
          stop();
          done("qna did not finish within " + timeoutMs / 1000 + " s");
          return;
        }
        setTimeout(poll, 150);
        return;
      }
      var text = "";
      try {
        if (fso.FileExists(outFile)) {
          var r = fso.OpenTextFile(outFile, 1, false);
          if (!r.AtEndOfStream) text = r.ReadAll();
          r.Close();
        }
      } catch (e) {}
      cleanup();
      fact("qna output (first 300 chars)", text.slice(0, 300).replace(/\r?\n/g, " | "));
      var p = parseQna(text);
      var info = [];
      if (p.types.length) info.push("type " + p.types.join(", "));
      if (p.times.length) info.push("time " + p.times.join(", "));
      info.push(now() - started + " ms wall");
      done(p.errors.length ? p.errors.join("; ") : null, p.answers, info.join(", "));
    }
    poll();
  }

  // ---- client relevance via FastQuery (console REST API) -----------------

  function xmlEscape(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function shuffled(list) {
    var a = list.slice(0);
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i];
      a[i] = a[j];
      a[j] = t;
    }
    return a;
  }

  function parseIds(text) {
    var out = [];
    var seen = {};
    var parts = text.split(/[\s,;]+/);
    for (var i = 0; i < parts.length; i++) {
      if (/^\d+$/.test(parts[i])) {
        // Each computer once: answers are counted per computer.
        if (!seen[parts[i]]) out.push(parts[i]);
        seen[parts[i]] = true;
      } else if (parts[i] !== "") return null;
    }
    return out;
  }

  // done(error, ids, why)
  function pickTargets(count, done) {
    var typed = $("ids").value;
    if (/\S/.test(typed)) {
      var ids = parseIds(typed);
      if (ids === null) done("IDs must be numbers separated by commas or spaces");
      else done(null, ids, "the IDs you entered");
      return;
    }
    evalSession(SESSION_TARGETS, function (err, answers) {
      if (err) {
        done("could not list recent computers: " + err);
        return;
      }
      if (!answers.length) {
        done("no computers reported in the last hour");
        return;
      }
      var pick = shuffled(answers).slice(0, count);
      done(null, pick, pick.length + " random of " + answers.length + " computers that reported in the last hour");
    }, "FastQuery targets");
  }

  function clientQueryXml(query, ids) {
    var targets = "";
    for (var i = 0; i < ids.length; i++) targets += "<ComputerID>" + ids[i] + "</ComputerID>";
    return (
      "<BESAPI><ClientQuery><ApplicabilityRelevance>true</ApplicabilityRelevance>" +
      "<QueryText>" +
      xmlEscape(query) +
      "</QueryText><Target>" +
      targets +
      "</Target></ClientQuery></BESAPI>"
    );
  }

  // onUpdate(rows, count, nextMs) after every check, with all results so far
  // (they are cumulative); done(error, rows, why) once. Waits the whole
  // timeout for computers that have not answered, unless ctx is cancelled.
  function evalFast(ctx, query, ids, timeoutMs, onUpdate, reportDone) {
    var started = now();
    var timer = null;
    var delay = POLL_FIRST_MS;
    var lastRows = [];
    var finished = false;
    // Once only, and never after a cancel.
    function done(err, rows, why) {
      if (finished || ctx.cancelled) return;
      finished = true;
      clearTimeout(timer);
      clearTimeout(watchdog);
      reportDone(err, rows || lastRows, why);
    }
    // A REST call whose callback never fires would otherwise leave the run
    // waiting forever: end it a little after the timeout with what came in.
    var watchdog = setTimeout(function () {
      done("no reply from the console's REST API within " + Math.round((timeoutMs + REPLY_MARGIN_MS) / 1000) + " s", lastRows);
    }, timeoutMs + REPLY_MARGIN_MS);
    ctx.cancels.push(function () {
      clearTimeout(timer);
      clearTimeout(watchdog);
    });
    try {
      window.API.Post("clientquery", clientQueryXml(query, ids), function (error, status, body) {
        if (ctx.cancelled) return;
        fact("API.Post clientquery", "status " + status + (error ? ", error " + errText(error) : ""));
        var m = /<ID>\s*(\d+)\s*<\/ID>/.exec(String(body || ""));
        if (error || !m) {
          done("FastQuery submit failed (status " + status + "): " + (error ? errText(error) : String(body).slice(0, 300)));
          return;
        }
        log("FastQuery " + m[1] + " submitted to " + ids.length + " computer(s)");
        poll(m[1]);
      });
    } catch (e) {
      done("API.Post threw: " + errText(e));
      return;
    }

    function poll(queryId) {
      if (ctx.cancelled) return;
      try {
        window.API.Get("clientqueryresults/" + queryId + "?output=json", function (error, status, body) {
          if (ctx.cancelled) return;
          var rows;
          try {
            rows = JSON.parse(body).results || [];
          } catch (e) {
            fact("clientqueryresults body", "status " + status + ", " + String(body).slice(0, 200));
            done("could not read FastQuery results (status " + status + "): " + (error ? errText(error) : errText(e)));
            return;
          }
          lastRows = rows;
          var seen = {};
          var count = 0;
          for (var i = 0; i < rows.length; i++) {
            if (!seen[rows[i].computerID]) {
              seen[rows[i].computerID] = true;
              count++;
            }
          }
          if (count >= ids.length) return done(null, rows, "all " + count + " answered");
          var left = timeoutMs - (now() - started);
          if (left <= 0) {
            return done(null, rows, count + " of " + ids.length + " answered within " + Math.round(timeoutMs / 1000) + " s");
          }
          var wait = Math.min(delay, left);
          delay = Math.min(delay * POLL_GROWTH, POLL_MAX_MS);
          onUpdate(rows, count, wait);
          timer = setTimeout(function () {
            poll(queryId);
          }, wait);
        });
      } catch (e) {
        done("API.Get threw: " + errText(e));
      }
    }
  }

  // ---- dialect (console) --------------------------------------------------

  // The console has no analyzer (IE11), so Auto is a keyword guess.
  var SESSION_HINT = /\b(bes\s+[a-z]|current\s+console\s+user|in\s+web\s+reports\s+context|current\s+user\b|all\s+bes\s)/i;
  var CLIENT_HINT = /\b(operating\s+system|registry|files?\s|folders?\s|computer\s+name|running\s+application|services?\b|processes|active\s+device|ip\s+interfaces?)/i;

  function chooseDialects(text) {
    var mode = $("dialect").value;
    if (mode === "session") return { dialects: ["session"], why: "you picked session relevance" };
    if (mode === "client") return { dialects: ["client"], why: "you picked client relevance" };
    if (mode === "both") return { dialects: ["session", "client"], why: "you picked both" };
    var s = SESSION_HINT.test(text);
    var c = CLIENT_HINT.test(text);
    if (s && !c) return { dialects: ["session"], why: "it mentions session inspectors (a keyword guess)" };
    if (c && !s) return { dialects: ["client"], why: "it mentions client inspectors (a keyword guess)" };
    return { dialects: ["session", "client"], why: "the keywords don't settle it, so both run" };
  }

  // ---- results (console table) ---------------------------------------------

  function tbody() {
    return $("results").getElementsByTagName("tbody")[0];
  }

  function addRow(cells) {
    var tr = document.createElement("tr");
    for (var i = 0; i < cells.length; i++) {
      var td = document.createElement("td");
      if (i === 3) td.className = "answer";
      if (i === 4 && cells[i]) td.className = "error";
      td.appendChild(document.createTextNode(cells[i] === null || cells[i] === undefined ? "" : String(cells[i])));
      tr.appendChild(td);
    }
    tbody().appendChild(tr);
    return tr;
  }

  function answersCell(answers) {
    if (!answers.length) return "(no answers)";
    var shown = answers.slice(0, MAX_SHOWN).join("\n");
    if (answers.length > MAX_SHOWN) shown += "\n... " + (answers.length - MAX_SHOWN) + " more";
    return shown;
  }

  function clearResults() {
    var body = tbody();
    while (body.firstChild) body.removeChild(body.firstChild);
  }

  // ---- what can run here -----------------------------------------------

  function clientPaths() {
    var local = host.activeX && hostKind() === "console";
    var fast = host.api;
    var why = [];
    if (!local) why.push(host.activeX ? "this computer (qna) needs the console" : "this computer (qna) needs ActiveX, which this browser does not have");
    if (!fast) why.push("FastQuery needs the console's REST API");
    $("useLocal").disabled = !local;
    $("useFast").disabled = !fast;
    if (!local) $("useLocal").checked = false;
    if (!fast) $("useFast").checked = false;
    setText("clientWhy", why.length ? "Unavailable here: " + why.join("; ") + "." : "");
    return { local: local, fast: fast };
  }

  // A notice only when this build is somewhere it cannot do its job.
  function describeHost() {
    var kind = hostKind();
    var engine = document.documentMode ? "IE " + document.documentMode + " engine" : "modern engine";
    fact("host", kind + ", " + engine);
    var notice = "";
    if (target === "console") {
      if (kind === "none") notice = "Open this as a dashboard in the BigFix console to evaluate relevance.";
      else if (kind !== "console") notice = "This is the console dashboard; in Web Reports use the Web Reports version.";
      clientPaths();
    } else {
      if (!host.session) notice = "Open this as a Web Report to evaluate session relevance. Analysis still works here.";
      if (!analyzer) setText("analysis", "The analyzer is " + analyzerNote + ".", "hint");
    }
    setText("hostNotice", notice);
    setText("footer", (kind === "none" ? "Standalone page" : kind === "console" ? "BigFix console" : "BigFix Web Reports") + " - " + engine + " - analyzer " + analyzerNote + " - built " + (build.built || "?"));
  }

  // ---- evaluate ------------------------------------------------------------

  function getQuery() {
    return (editor ? editor.getText() : $("rel").value).replace(/^\s+|\s+$/g, "");
  }

  // Only the current run may finish the page's run state.
  function finishRun(ctx, message) {
    if (run !== ctx) return;
    run = null;
    if ($("cancel")) $("cancel").disabled = true;
    setText("status", message);
  }

  // Evaluate stays clickable while a run is going: a new query abandons it.
  function startRun() {
    if (run) stopRun("abandoned for a new query");
    run = { cancelled: false, cancels: [] };
    if ($("cancel")) $("cancel").disabled = false;
    setText("status", "Evaluating...");
    return run;
  }

  function stopRun(why) {
    var ctx = run;
    if (!ctx) return;
    ctx.cancelled = true;
    for (var i = 0; i < ctx.cancels.length; i++) {
      try {
        ctx.cancels[i]();
      } catch (e) {}
    }
    log("previous run " + why);
    finishRun(ctx, "Cancelled.");
  }

  // Web Reports: what the analyzer's dialect call means here. Session
  // relevance runs whatever it says; the note only sets expectations.
  function showDialect(choice) {
    var note = "";
    if (choice.dialects.length === 1 && choice.dialects[0] === "client") {
      note = "This looks like client relevance (" + choice.why + "), which Web Reports cannot evaluate. Evaluate tries it as session relevance anyway, in case that is wrong.";
    } else if (choice.dialects.length > 1) {
      note = "Evaluate runs it as session relevance: " + choice.why + ".";
    }
    if ($("dialectNote")) setText("dialectNote", note);
  }

  // Web Reports: analysis, then session relevance, always. Client relevance
  // cannot run here, but the dialect call can be wrong and a session error
  // comes back at once, so it is tried anyway after saying so.
  function evaluateWebReport() {
    var query = getQuery();
    if (!query) return;
    if (analyzer) {
      try {
        analyzer.analyze(query); // shows the dialect note too
      } catch (e) {
        log("analysis failed: " + errText(e));
      }
    }
    var out = $("wrResult");
    if (!host.session) {
      setText("wrResult", "Session relevance can only be evaluated in Web Reports.", "hint");
      return;
    }
    var ctx = startRun();
    log("session: evaluating");
    evalSession(query, function (err, answers, info) {
      if (ctx.cancelled) return;
      out.innerHTML = "";
      out.className = "";
      var summary = document.createElement("p");
      summary.className = "summary" + (err ? " error" : "");
      summary.appendChild(document.createTextNode(err ? "Error" : answers.length === 1 ? "1 answer" : answers.length + " answers"));
      var detail = document.createElement("span");
      detail.className = "hint";
      detail.appendChild(document.createTextNode("  -  " + info));
      summary.appendChild(detail);
      out.appendChild(summary);
      if (err) {
        var box = document.createElement("div");
        box.className = "errbox";
        box.appendChild(document.createTextNode(err));
        out.appendChild(box);
      } else if (answers.length) {
        var list = document.createElement("ol");
        list.className = "answers";
        for (var i = 0; i < answers.length && i < MAX_SHOWN; i++) {
          var li = document.createElement("li");
          li.appendChild(document.createTextNode(answers[i]));
          list.appendChild(li);
        }
        out.appendChild(list);
        if (answers.length > MAX_SHOWN) {
          var more = document.createElement("p");
          more.className = "hint";
          more.appendChild(document.createTextNode("... and " + (answers.length - MAX_SHOWN) + " more"));
          out.appendChild(more);
        }
      }
      log("session: " + (err ? "error" : answers.length + " answer(s)"));
      finishRun(ctx, "Done.");
    });
  }

  // FastQuery's rows in the console table, redrawn on every check: one per
  // computer that answered, then one per target still waiting.
  function fastQueryRows(ids, why) {
    var drawn = [];
    return function (rows, final) {
      for (var d = 0; d < drawn.length; d++) {
        if (drawn[d].parentNode) drawn[d].parentNode.removeChild(drawn[d]);
      }
      drawn = [];
      var byComputer = {};
      var order = [];
      for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var key = String(r.computerID);
        if (!byComputer[key]) {
          byComputer[key] = { name: r.computerName, answers: [], errors: [], ms: r.ResponseTime };
          order.push(key);
        }
        (r.isFailure ? byComputer[key].errors : byComputer[key].answers).push(r.result);
      }
      for (var k = 0; k < order.length; k++) {
        var c = byComputer[order[k]];
        drawn.push(addRow(["client", "FastQuery", c.name + " (" + order[k] + ")", answersCell(c.answers), c.errors.join("; "), c.ms + " ms"]));
      }
      for (var n = 0; n < ids.length; n++) {
        if (!byComputer[ids[n]]) {
          drawn.push(addRow(["client", "FastQuery", ids[n], final ? "" : "waiting...", "", final ? "no answer" : why]));
        }
      }
    };
  }

  // Console: session and/or client relevance, as picked or guessed.
  function evaluateConsole() {
    var query = getQuery();
    if (!query) return;
    var choice = chooseDialects(query);
    var paths = clientPaths();
    var ctx = startRun();
    setText("dialectWhy", "Runs " + choice.dialects.join(" then ") + ": " + choice.why + ".");
    clearResults();
    var timeoutMs = Math.max(5, parseInt($("timeoutSec").value, 10) || 90) * 1000;
    var steps = [];

    for (var d = 0; d < choice.dialects.length; d++) {
      if (choice.dialects[d] === "session") {
        steps.push(function (next) {
          if (!host.session) {
            addRow(["session", "-", "", "", "Session relevance needs the BigFix console.", ""]);
            return next();
          }
          log("session: evaluating");
          evalSession(query, function (err, answers, info) {
            if (ctx.cancelled) return;
            addRow(["session", "this deployment", "", err ? "" : answersCell(answers), err, answers.length + " answer(s), " + info]);
            log("session: " + (err ? "error" : answers.length + " answer(s)"));
            next();
          });
        });
      } else {
        if (!$("useLocal").checked && !$("useFast").checked) {
          steps.push(function (next) {
            var why = paths.local || paths.fast ? "Tick This computer or FastQuery to run it." : $("clientWhy").textContent;
            addRow(["client", "-", "", "", "", "Not evaluated. " + why]);
            next();
          });
        }
        if ($("useLocal").checked) {
          steps.push(function (next) {
            log("client: qna on this computer");
            evalLocal(ctx, query, timeoutMs, function (err, answers, info) {
              if (ctx.cancelled) return;
              addRow(["client", "this computer (qna)", "", err && !answers ? "" : answersCell(answers || []), err, info || ""]);
              log("client qna: " + (err ? "error" : (answers || []).length + " answer(s)"));
              next();
            });
          });
        }
        if ($("useFast").checked) {
          steps.push(function (next) {
            var count = Math.max(1, parseInt($("fastCount").value, 10) || 5);
            pickTargets(count, function (err, ids, why) {
              if (ctx.cancelled) return;
              if (err) {
                addRow(["client", "FastQuery", "", "", err, ""]);
                return next();
              }
              log("FastQuery targets: " + ids.join(", ") + " (" + why + ")");
              var draw = fastQueryRows(ids, why);
              draw([], false);
              evalFast(
                ctx,
                query,
                ids,
                timeoutMs,
                function (rows, answered, nextMs) {
                  draw(rows, false);
                  setText("status", "FastQuery: " + answered + " of " + ids.length + " answered; checking again in " + Math.round(nextMs / 1000) + " s...");
                },
                function (err2, rows, why2) {
                  if (ctx.cancelled) return;
                  draw(rows || [], true);
                  if (err2) addRow(["client", "FastQuery", "", "", err2, why]);
                  log("FastQuery: " + (err2 || why2));
                  next();
                }
              );
            });
          });
        }
      }
    }

    var i = 0;
    function next() {
      if (ctx.cancelled) return;
      if (i >= steps.length) return finishRun(ctx, "Done.");
      steps[i++](next);
    }
    next();
  }

  function evaluate() {
    if (target === "console") evaluateConsole();
    else evaluateWebReport();
  }

  function cancel() {
    stopRun("cancelled");
  }

  function copyDiagnostics() {
    var box = $("diagText");
    box.focus();
    box.select();
    var ok = false;
    try {
      ok = document.execCommand("copy");
    } catch (e) {}
    if (!ok && window.clipboardData) {
      try {
        ok = window.clipboardData.setData("Text", box.value);
      } catch (e) {}
    }
    log(ok ? "diagnostics copied" : "select the diagnostics text and copy it by hand");
  }

  // Reload the analyzer (troubleshooting, webreport only): the loader forgets
  // its cached copy and any "does not start here" record, then loads it
  // again, without reloading the page. The editor's text goes back to the
  // plain text box meanwhile, so Evaluate keeps working on it.
  function reloadAnalyzer() {
    if (!analyzerReload) {
      log("the analyzer cannot be reloaded: its loader did not run in this browser");
      return;
    }
    if (editor) {
      $("rel").value = editor.getText();
      $("rel").style.display = "";
    }
    analyzer = null;
    editor = null;
    analyzerLoading("reloading");
    fact("analyzer", analyzerNote);
    describeHost();
    log("reloading the analyzer");
    analyzerReload();
  }

  // A load (or Reload) of the analyzer begins: note it, disable Reload until
  // it settles, and give up on it after 5 minutes if it never does.
  function analyzerLoading(note) {
    analyzerNote = note;
    analyzerPending = true;
    setReloadEnabled(false);
    loadAttempt += 1;
    var mine = loadAttempt;
    setTimeout(function () {
      if (analyzerPending && loadAttempt === mine) window.rdbg.onAnalyzerFailed("did not load within 5 minutes");
    }, 300000);
  }

  function analyzerSettled() {
    analyzerPending = false;
    setReloadEnabled(true);
  }

  function setReloadEnabled(on) {
    var button = $("reloadAnalyzer");
    if (button) button.disabled = !on;
  }

  // ---- page setup ------------------------------------------------------------

  // Drop the other target's parts (data-only="console" / "webreport").
  function keepTarget() {
    var all = document.getElementById("rdbg").getElementsByTagName("*");
    var drop = [];
    for (var i = 0; i < all.length; i++) {
      var only = all[i].getAttribute("data-only");
      if (only && only !== target) drop.push(all[i]);
    }
    for (var j = 0; j < drop.length; j++) {
      if (drop[j].parentNode) drop[j].parentNode.removeChild(drop[j]);
    }
  }

  // IE11 has no <details>: show only the summary until it is clicked.
  function polyfillDetails() {
    if ("open" in document.createElement("details")) return;
    document.getElementById("rdbg").className += " no-details";
    var all = document.getElementsByTagName("details");
    for (var i = 0; i < all.length; i++) {
      (function (d) {
        var summary = d.getElementsByTagName("summary")[0];
        function show(open) {
          for (var c = d.firstChild; c; c = c.nextSibling) {
            if (c.nodeType === 1 && c !== summary) c.style.display = open ? "" : "none";
          }
          if (open) d.setAttribute("open", "open");
          else d.removeAttribute("open");
        }
        show(false);
        summary.onclick = function () {
          show(!d.getAttribute("open"));
        };
      })(all[i]);
    }
  }

  // ---- hooks for the analyzer layer (webreport) ---------------------------

  window.rdbg = {
    // api: {dialect(text) -> {dialects, why}, analyze(text), editor: {getText}}
    onAnalyzer: function (api, info) {
      fact("analyzer ready", seconds(sinceStart()) + " after the request started");
      analyzer = api;
      if (api.editor) {
        editor = api.editor;
        $("rel").style.display = "none";
      }
      analyzerSettled();
      analyzerNote = "loaded" + (info ? " (" + info + ")" : "");
      fact("analyzer", analyzerNote);
      describeHost();
      log("analyzer " + analyzerNote);
    },
    onAnalyzerFailed: function (reason) {
      analyzerSettled();
      analyzerNote = "unavailable: " + reason;
      fact("analyzer", analyzerNote);
      describeHost();
      log("analyzer " + analyzerNote);
    },
    // reload(): forget the cached analyzer and load it again; it ends in
    // onAnalyzer or onAnalyzerFailed.
    setAnalyzerReload: function (reload) {
      analyzerReload = reload;
    },
    initialText: function () {
      return $("rel").value;
    },
    evaluate: evaluate,
    showDialect: showDialect,
    // For test_reports.mjs: the parts of the console paths a test can check
    // without ActiveX or a real console.
    internals: { parseQna: parseQna, parseIds: parseIds, clientQueryXml: clientQueryXml, toList: toList },
    log: log,
    fact: fact,
  };

  // ---- start -----------------------------------------------------------------

  // window.RDBG_BUILD is set by build_poc.py in a script before this one.
  var build = window.RDBG_BUILD || {};
  var target = build.target === "webreport" ? "webreport" : "console";
  keepTarget();
  polyfillDetails();

  fact("core ready (Evaluate usable)", seconds(sinceStart()) + " after the request started");
  host = detectHost();
  fact("build", target + ", built " + (build.built || "?"));
  fact("userAgent", navigator.userAgent);
  fact("documentMode", document.documentMode || "none");
  fact("WebAssembly", typeof window.WebAssembly);
  fact("DecompressionStream", typeof window.DecompressionStream);
  fact("ActiveXObject", host.activeX);
  fact("Relevance", hasGlobal("Relevance") ? typeof window.Relevance : "missing");
  fact("EvaluateRelevance", hasGlobal("EvaluateRelevance") ? typeof window.EvaluateRelevance : "missing");
  fact("API.Post/API.Get", host.api);
  fact("location", location.protocol + "//" + location.host);
  // Measured once the whole page has parsed, not just up to this script.
  var measure = function () {
    fact("page size (chars)", document.documentElement.outerHTML.length);
    // loadEventStart is only set once the load handlers are running.
    setTimeout(loadTimings, 0);
  };
  if (window.addEventListener) window.addEventListener("load", measure, false);
  else window.attachEvent("onload", measure);

  if (!build.analyzer) {
    analyzerNote = "not part of the console version";
  } else if (document.documentMode) {
    analyzerNote = "unavailable: this browser cannot run it (IE)";
  } else {
    analyzerLoading(LOADING_NOTE);
  }
  fact("analyzer", analyzerNote);
  describeHost();

  if (host.session) {
    evalSession(
      "in web reports context",
      function (err, answers) {
        host.webReports = err ? null : /^true$/i.test(answers[0]);
        fact("in web reports context", err ? "error: " + err : answers.join(", "));
        describeHost();
      },
      "web reports probe"
    );
  }

  $("evaluate").onclick = evaluate;
  if ($("cancel")) $("cancel").onclick = cancel;
  $("copyDiag").onclick = copyDiagnostics;
  if ($("reloadAnalyzer")) $("reloadAnalyzer").onclick = reloadAnalyzer;
  // Ctrl+Enter in the plain textarea (the analyzer's editor has its own).
  $("rel").onkeydown = function (e) {
    e = e || window.event;
    if (e.keyCode === 13 && (e.ctrlKey || e.metaKey)) {
      evaluate();
      return false;
    }
  };
  log("core ready (" + target + ")");
})();

</script>
<script type="module">
// loader.mjs: loadAndStart(), forgetAnalyzer(), dialectChoice(), and what they use.
// Where the Web Report's analyzer comes from, and its cache: the parts of the
// loader that run without a page, so test_loader.mjs can drive them in Node
// with a fake fetch and cache. build_poc.py inlines this file into
// analyzer_loader.html's module script, which supplies the real ones:
//
//   env = { fetch, cacheGet(key), cachePut(key, value), cacheDelete(key),
//           log(text), now(),
//           subtle,    (crypto.subtle; missing in insecure contexts)
//           baseUrl }  (what relative URLs resolve against: the page)
//
// Two kinds of source, by URL: a split analyzer's manifest.json (the
// contract is ../SPLIT_ANALYZER.md), or the single-file playground page.
//
// Either way the result is the same set of pieces: { editor (script text),
// glue (module text), cores: { name: Uint8Array } } where each core's bytes
// are gzipped, or already plain wasm if a server decompressed them in transit.
//
// It is inlined into a <script> element, so it must never spell out that
// element's closing tag, even in a string or comment (the builder checks).

// ---- the single-file playground page --------------------------------------

export function between(text, start, end, what) {
  const i = text.indexOf(start);
  if (i < 0 || text.indexOf(start, i + 1) >= 0) throw new Error(`${what}: expected exactly one "${start}"`);
  const from = i + start.length;
  const to = text.indexOf(end, from);
  if (to < 0) throw new Error(`${what}: no "${end}" after "${start}"`);
  return text.slice(from, to);
}

// The three pieces of the published single-file playground page, found by
// text that appears exactly once there (see
// ../componentize-py/build-playground/template.html and
// ../common/shared_script.html): the editor bundle, the gzipped cores
// (base64), and the component glue jco generated for exactly those cores.
export function extract(html) {
  const editor = between(html, "Publishes window.playgroundEditor.\n", "\n<\/script>", "editor bundle");
  const coresLiteral = between(html, "const CORES_GZIP = ", ";\n", "core modules");
  // The glue sits between the end of boot() and the template's closing code.
  const afterBoot = between(html, "async function boot()", "// window.__wasmProblem was already handled", "component glue");
  const glue = afterBoot.slice(afterBoot.indexOf("\n}\n") + 3);
  const cores = JSON.parse(coresLiteral);
  const names = Object.keys(cores);
  if (!editor.includes("playgroundEditor")) throw new Error("editor bundle: no playgroundEditor");
  if (!glue.includes("__component")) throw new Error("component glue: no globalThis.__component");
  if (!names.length || !names.every((n) => /^analyzer\.core\d*\.wasm$/.test(n))) {
    throw new Error(`core modules: unexpected names ${names.join(", ")}`);
  }
  for (const name of names) {
    if (!glue.includes(`"./${name}"`)) throw new Error(`component glue does not load ${name}`);
  }
  return { editor, cores, glue };
}

// ---- fetching and caching ---------------------------------------------------

// The pieces from `url`: the cached copy while the page's Last-Modified is
// unchanged (or cannot be checked), else a fresh download.
export async function fromPage(url, env) {
  const key = `page:${url}`;
  const cached = await env.cacheGet(key);
  let lastModified = null;
  let unreachable = false;
  try {
    const head = await env.fetch(url, { method: "HEAD", cache: "no-store" });
    if (head.ok) lastModified = head.headers.get("Last-Modified");
  } catch (err) {
    if (!cached) throw err;
    unreachable = true;
    env.log(`analyzer: ${url} unreachable (${err}); using the cached copy`);
  }
  // Unreachable: the cached copy is all there is. A server that refuses HEAD
  // or sends no Last-Modified cannot say whether it changed, so download.
  await refuseIfRecorded(key, unreachable ? cached.lastModified ?? null : lastModified, env);
  if (cached && (unreachable || (lastModified !== null && cached.lastModified === lastModified))) {
    return { pieces: cached, how: "cached", key, fresh: false };
  }
  const started = env.now();
  // HEAD gave no Last-Modified, so it cannot say whether a page recorded as
  // not starting changed: ask the GET, so the same page costs a 304, not a
  // download. The header makes a cross-origin request preflighted; if that
  // fails, download as before (the check after the download still applies).
  const record = !unreachable && lastModified === null ? await env.cacheGet(recordKey(key)) : undefined;
  let res;
  if (record && record.id) {
    try {
      res = await env.fetch(url, { cache: "no-store", headers: { "If-Modified-Since": record.id } });
    } catch (err) {
      env.log(`analyzer: ${url} refused a conditional request (${err.message || err}); downloading it`);
    }
    if (res && res.status === 304) throw doesNotStart(record);
  }
  if (!res) res = await env.fetch(url, { cache: "no-store" });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const html = await res.text();
  const found = extract(html);
  const cores = {};
  for (const [name, b64] of Object.entries(found.cores)) cores[name] = bytesFromBase64(b64);
  const pieces = { ...found, cores, lastModified: res.headers.get("Last-Modified") || lastModified };
  // A server that answers HEAD without Last-Modified but sends it here: the
  // record is only checkable now.
  if (pieces.lastModified !== lastModified) await refuseIfRecorded(key, pieces.lastModified, env);
  const mb = (html.length / 1048576).toFixed(1);
  try {
    await env.cachePut(key, pieces);
  } catch (err) {
    env.log(`analyzer: could not cache it (${err}); it will download again next time`);
  }
  return { pieces, how: `downloaded ${mb} MB in ${Math.round(env.now() - started)} ms`, key, fresh: true };
}

// The first of `urls` that works; `source` names it for the diagnostics. A URL
// ending in .json is a split analyzer's manifest, anything else the
// single-file playground page. Also `key` (its cache key) and `fresh` (every
// file was just downloaded, none came from the cache), for loadAndStart().
export async function loadPieces(urls, env) {
  const problems = [];
  for (const url of urls) {
    try {
      if (isManifestUrl(url)) {
        const got = await fromManifest(url, env);
        return { ...got, source: `${url} (analyzer ${got.pieces.version}, ${got.how})` };
      }
      const got = await fromPage(url, env);
      return { ...got, source: `${url} (${got.how}, Last-Modified ${got.pieces.lastModified || "unknown"})` };
    } catch (err) {
      // Recorded as not starting here: stop, rather than download and fail
      // again from the next source.
      if (err.doesNotStart) throw err;
      problems.push(`${url}: ${err.message || err}`);
      env.log(`analyzer: ${url} failed: ${err.message || err}`);
    }
  }
  throw new Error(problems.join("; ") || "no analyzer URL configured");
}

// ---- the split analyzer: manifest.json and its files ------------------------

export const isManifestUrl = (url) => /\.json([?#]|$)/.test(url);

const BARE_NAME = /^[A-Za-z0-9_-][A-Za-z0-9._-]*$/;
const SHA256_HEX = /^[0-9a-f]{64}$/;
const CORE_NAME = /^analyzer\.core\d*\.wasm$/;
const GLUE_CORES = /"\.\/(analyzer\.core\d*\.wasm)"/g;

// The manifest, checked against ../SPLIT_ANALYZER.md (format 1); throws on anything
// else.
export function parseManifest(text) {
  let m;
  try {
    m = JSON.parse(text);
  } catch (err) {
    throw new Error(`manifest: not JSON (${err.message})`);
  }
  if (!m || m.format !== 1) throw new Error(`manifest: format ${m && m.format} is not 1`);
  if (typeof m.version !== "string" || !m.version) throw new Error("manifest: no version");
  const checkFile = (f, what) => {
    if (!f || typeof f.path !== "string" || !BARE_NAME.test(f.path)) {
      throw new Error(`manifest: ${what} path must be a bare file name`);
    }
    if (!Number.isInteger(f.size) || f.size < 0) throw new Error(`manifest: ${what} size is missing`);
    if (typeof f.sha256 !== "string" || !SHA256_HEX.test(f.sha256)) {
      throw new Error(`manifest: ${what} sha256 must be 64 lowercase hex digits`);
    }
  };
  checkFile(m.editor, "editor");
  checkFile(m.glue, "glue");
  if (!Array.isArray(m.cores) || !m.cores.length) throw new Error("manifest: no cores");
  const seen = new Set();
  for (const core of m.cores) {
    checkFile(core, `core ${core && core.name}`);
    if (typeof core.name !== "string" || !CORE_NAME.test(core.name)) {
      throw new Error(`manifest: core name ${core.name} is not like analyzer.core*.wasm`);
    }
    if (core.encoding !== "gzip") throw new Error(`manifest: core ${core.name} encoding ${core.encoding} is not gzip`);
    // Optional: the inflated wasm, to verify a core a server decompressed.
    if (core.raw_size !== undefined && (!Number.isInteger(core.raw_size) || core.raw_size < 0)) {
      throw new Error(`manifest: core ${core.name} raw_size is not a size`);
    }
    if (core.raw_sha256 !== undefined && (typeof core.raw_sha256 !== "string" || !SHA256_HEX.test(core.raw_sha256))) {
      throw new Error(`manifest: core ${core.name} raw_sha256 must be 64 lowercase hex digits`);
    }
    if (seen.has(core.name)) throw new Error(`manifest: duplicate core ${core.name}`);
    seen.add(core.name);
  }
  return m;
}

const isGzip = (bytes) => bytes[0] === 0x1f && bytes[1] === 0x8b;
const isWasm = (bytes) => bytes[0] === 0x00 && bytes[1] === 0x61 && bytes[2] === 0x73 && bytes[3] === 0x6d;
const hex = (buffer) => Array.from(new Uint8Array(buffer), (b) => b.toString(16).padStart(2, "0")).join("");

// SHA-256 of `bytes` as lowercase hex, in plain JavaScript: crypto.subtle is
// missing in insecure contexts, such as a Web Reports server on plain http,
// and every file is still checked there.
export function sha256Hex(bytes) {
  const K = new Uint32Array([
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ]);
  const h = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);
  // The message, then 0x80, zeros, and the bit length as 64 bits: a whole
  // number of 64-byte blocks.
  const total = Math.ceil((bytes.length + 9) / 64) * 64;
  const data = new Uint8Array(total);
  data.set(bytes);
  data[bytes.length] = 0x80;
  const view = new DataView(data.buffer);
  view.setUint32(total - 8, Math.floor(bytes.length / 0x20000000));
  view.setUint32(total - 4, (bytes.length * 8) >>> 0);
  const w = new Uint32Array(64);
  const rotr = (x, n) => (x >>> n) | (x << (32 - n));
  for (let block = 0; block < total; block += 64) {
    for (let i = 0; i < 16; i++) w[i] = view.getUint32(block + i * 4);
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const t1 = (hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i]) >>> 0;
      const t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + t1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (t1 + t2) >>> 0;
    }
    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
  }
  return Array.from(h, (x) => x.toString(16).padStart(8, "0")).join("");
}

async function sha256Of(bytes, env) {
  return env.subtle ? hex(await env.subtle.digest("SHA-256", bytes)) : sha256Hex(bytes);
}

// Throws unless `bytes` are what the manifest entry `file` describes: the
// published bytes (size, sha256), or for a core a server decompressed in
// transit, the inflated wasm (raw_size, raw_sha256).
async function verify(file, bytes, env) {
  if (file.encoding === "gzip" && !isGzip(bytes) && isWasm(bytes)) {
    if (!file.raw_sha256) throw new Error(`${file.path}: decompressed in transit, and the manifest has no raw_sha256 to check it`);
    if (bytes.length !== file.raw_size) throw new Error(`${file.path}: raw size ${bytes.length}, manifest says ${file.raw_size}`);
    if ((await sha256Of(bytes, env)) !== file.raw_sha256) throw new Error(`${file.path}: raw_sha256 does not match the manifest`);
    return;
  }
  if (bytes.length !== file.size) throw new Error(`${file.path}: size ${bytes.length}, manifest says ${file.size}`);
  if ((await sha256Of(bytes, env)) !== file.sha256) throw new Error(`${file.path}: sha256 does not match the manifest`);
}

// Every piece of a cached set, checked against its own manifest again before
// it runs, where crypto.subtle makes that cheap: storage is shared with every
// page on the origin.
async function verifyCached(pieces, env) {
  const manifest = parseManifest(pieces.manifestText);
  const encode = (text) => new TextEncoder().encode(text);
  await verify(manifest.editor, encode(pieces.editor), env);
  await verify(manifest.glue, encode(pieces.glue), env);
  for (const core of manifest.cores) {
    if (!pieces.cores[core.name]) throw new Error(`${core.path}: missing from the cache`);
    await verify(core, pieces.cores[core.name], env);
  }
}

// The set `url` names: from the cache while the manifest text is unchanged
// and the cached files still match it, or while the manifest cannot be
// fetched; else downloaded whole and checked. If a newer manifest's set fails,
// a cached set (of the older manifest) is kept rather than nothing.
export async function fromManifest(configured, env) {
  // Absolute, so the file names in it can resolve against it.
  const url = new URL(configured, env.baseUrl).href;
  const key = `manifest:${url}`;
  let cached = await env.cacheGet(key);
  let text;
  try {
    const res = await env.fetch(url, { cache: "no-cache" });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    text = await res.text();
  } catch (err) {
    if (!cached) throw err;
    env.log(`analyzer: ${url} unreachable (${err.message || err}); using the cached set`);
    await refuseIfRecorded(key, manifestId(cached.manifestText), env);
    return { pieces: cached, how: "cached", key, fresh: false };
  }
  await refuseIfRecorded(key, manifestId(text), env);
  if (cached && cached.manifestText === text) {
    // The set was fully verified when it downloaded. Checking it again
    // guards against another page on the origin rewriting the cache; that
    // costs ~5 ms with crypto.subtle, but ~150 ms of JavaScript hashing on
    // every load without it (plain http), so there the set is trusted.
    if (!env.subtle) return { pieces: cached, how: "cached", key, fresh: false };
    try {
      await verifyCached(cached, env);
      return { pieces: cached, how: "cached", key, fresh: false };
    } catch (err) {
      env.log(`analyzer: the cached set from ${url} does not match its manifest (${err.message}); downloading it again`);
      cached = undefined;
    }
  }
  try {
    // The cached set is the older manifest's: its unchanged files are reused.
    return await downloadSet(url, key, text, env, cached);
  } catch (err) {
    if (!cached) throw err;
    env.log(`analyzer: the newer manifest at ${url} failed (${err.message}); keeping the cached set`);
    await refuseIfRecorded(key, manifestId(cached.manifestText), env, `the newer manifest failed: ${err.message}`);
    return { pieces: cached, how: `cached (the newer manifest failed: ${err.message})`, key, fresh: false };
  }
}

// Every file `text` names, checked, then cached as one set. With `previous`
// (the set cached under the older manifest), a file whose cached copy already
// is what the new manifest names is reused instead of downloaded (most cores
// do not change between releases). The new set is still checked and cached
// whole, so it never mixes versions.
async function downloadSet(url, key, text, env, previous) {
  const manifest = parseManifest(text);
  const started = env.now();
  const files = [manifest.editor, manifest.glue, ...manifest.cores];
  const reused = previous ? await reusable(manifest, previous, env) : files.map(() => null);
  const bytes = await Promise.all(
    files.map(async (file, i) => {
      if (reused[i]) return reused[i];
      let res;
      try {
        res = await env.fetch(new URL(file.path, url).href, { cache: "no-cache" });
      } catch (err) {
        throw new Error(`${file.path}: ${err.message || err}`);
      }
      if (!res.ok) throw new Error(`${file.path}: HTTP ${res.status}`);
      return new Uint8Array(await res.arrayBuffer());
    }),
  );
  for (let i = 0; i < files.length; i++) if (!reused[i]) await verify(files[i], bytes[i], env);
  const decode = (b) => new TextDecoder().decode(b);
  const editor = decode(bytes[0]);
  const glue = decode(bytes[1]);
  const cores = {};
  manifest.cores.forEach((core, i) => (cores[core.name] = bytes[i + 2]));
  const loaded = new Set(Array.from(glue.matchAll(GLUE_CORES), (m) => m[1]));
  for (const name of Object.keys(cores)) {
    if (!loaded.has(name)) throw new Error(`manifest core ${name} is not loaded by glue.mjs`);
  }
  for (const name of loaded) {
    if (!(name in cores)) throw new Error(`glue.mjs loads ${name}, which the manifest does not list`);
  }

  const pieces = { editor, glue, cores, version: manifest.version, manifestText: text };
  try {
    await env.cachePut(key, pieces);
  } catch (err) {
    env.log(`analyzer: could not cache it (${err}); it will download again next time`);
  }
  const fetched = bytes.filter((b, i) => !reused[i]);
  const reuseCount = files.length - fetched.length;
  const mb = (fetched.reduce((n, b) => n + b.length, 0) / 1048576).toFixed(1);
  const what = `downloaded ${fetched.length} file${fetched.length === 1 ? "" : "s"} (${mb} MB)${reuseCount ? `, reused ${reuseCount}` : ""}`;
  const how = env.subtle ? "checked sizes and sha256" : "checked sizes and sha256 (in JavaScript: no crypto.subtle here)";
  return { pieces, how: `${what} in ${Math.round(env.now() - started)} ms, ${how}`, key, fresh: reuseCount === 0 };
}

// For each file of `manifest` (editor, glue, cores, as downloadSet orders
// them), the cached bytes from `previous` that can stand in for a download,
// or null. Only a file whose entry in the older manifest has the same sha256
// is a candidate: its bytes were checked against that hash when they
// downloaded. With crypto.subtle they are hashed again against the new
// manifest (cheap), so a cache another page rewrote is caught. Without it
// (plain http) they are trusted, as a cached set is on reopening there.
async function reusable(manifest, previous, env) {
  let old;
  try {
    old = parseManifest(previous.manifestText);
  } catch {
    return [manifest.editor, manifest.glue, ...manifest.cores].map(() => null);
  }
  const encode = (text) => (typeof text === "string" ? new TextEncoder().encode(text) : undefined);
  const oldCores = new Map(old.cores.map((c) => [c.name, c]));
  const candidates = [
    [manifest.editor, old.editor, encode(previous.editor)],
    [manifest.glue, old.glue, encode(previous.glue)],
    ...manifest.cores.map((c) => [c, oldCores.get(c.name), previous.cores && previous.cores[c.name]]),
  ];
  return Promise.all(
    candidates.map(async ([file, before, bytes]) => {
      if (!before || !(bytes instanceof Uint8Array) || before.sha256 !== file.sha256) return null;
      const inflated = file.encoding === "gzip" && !isGzip(bytes) && isWasm(bytes);
      if (inflated && (!file.raw_sha256 || before.raw_sha256 !== file.raw_sha256)) return null;
      if (!env.subtle) return bytes.length === (inflated ? file.raw_size : file.size) ? bytes : null;
      try {
        await verify(file, bytes, env);
        return bytes;
      } catch (err) {
        env.log(`analyzer: ${file.path}: the cached copy does not match the new manifest (${err.message}); downloading it`);
        return null;
      }
    }),
  );
}

// ---- a set that does not start -------------------------------------------

// What identifies a source's current set: the sha256 of its manifest's text,
// or the single-file page's Last-Modified (null if the server sends none).
const manifestId = (text) => sha256Hex(new TextEncoder().encode(text));
const setId = (got) => (got.key.startsWith("manifest:") ? manifestId(got.pieces.manifestText) : got.pieces.lastModified ?? null);
const recordKey = (key) => `nostart:${key}`;
// The id of the last set loadAndStart() downloaded again because its cached
// copy did not start: each set gets that retry once per browser.
const retriedKey = (key) => `retried:${key}`;

function doesNotStart(record, also) {
  const err = new Error(
    `it does not start in this browser (${record.what}; tried ${record.time}): ${record.error}. ` +
      (also ? `Also, ${also}. ` : "") +
      "Reload the analyzer under Log and diagnostics to try again",
  );
  err.doesNotStart = true;
  return err;
}

// Throws if the set `id` names, from the source cached under `key`, is
// recorded as not starting in this browser: then nothing is downloaded or run
// until the source changes (a new release) or the record is forgotten.
// `also`: anything else the message should say.
async function refuseIfRecorded(key, id, env, also) {
  const record = await env.cacheGet(recordKey(key));
  if (record && record.id === id) throw doesNotStart(record, also);
}

async function startOrRecord(got, start, env) {
  try {
    return { ...got, started: await start(got.pieces) };
  } catch (err) {
    const record = { id: setId(got), error: String(err.message || err), time: new Date().toISOString(), what: got.source };
    env.log(`analyzer: ${got.source} did not start (${record.error}); not trying this set again in this browser`);
    try {
      await env.cachePut(recordKey(got.key), record);
    } catch (putErr) {
      env.log(`analyzer: could not record that (${putErr}); it will be tried again next time`);
    }
    throw doesNotStart(record);
  }
}

// loadPieces(), then start(pieces) (the page's: it runs the analyzer), with a
// safety net for a set that downloads and checks out but does not start. A
// cached set gets one more chance, once per set and browser: it is dropped
// and downloaded afresh. A set that does not start after that (or that was
// downloaded fresh in the first place) is recorded against its manifest (or
// page Last-Modified), so later loads stop before downloading it; a new
// release is tried again. At worst, one extra download per release per
// browser (for a set partly reused from the cache: that partial download,
// then one full one).
// Network and checksum failures are loadPieces' and never land here.
export async function loadAndStart(urls, env, start) {
  const got = await loadPieces(urls, env);
  if (got.fresh) return startOrRecord(got, start, env);
  const id = setId(got);
  const retried = await env.cacheGet(retriedKey(got.key));
  // Already retried for this set (it started then, but not now): an
  // intermittent failure must not cost a download on every load.
  if (retried && retried.id === id) return startOrRecord(got, start, env);
  try {
    return { ...got, started: await start(got.pieces) };
  } catch (err) {
    env.log(`analyzer: the cached set from ${got.source} did not start (${err.message || err}); downloading it again`);
    try {
      await env.cachePut(retriedKey(got.key), { id, time: new Date().toISOString() });
      await env.cacheDelete(got.key);
    } catch (cacheErr) {
      env.log(`analyzer: could not update the cache (${cacheErr})`);
    }
  }
  return startOrRecord(await loadPieces(urls, env), start, env);
}

// For "Reload the analyzer": drops the cached sets and "does not start"
// records of `urls`, so the next loadAndStart() starts from scratch. Returns
// the cache keys it removed.
export async function forgetAnalyzer(urls, env) {
  const removed = [];
  for (const url of urls) {
    const key = isManifestUrl(url) ? `manifest:${new URL(url, env.baseUrl).href}` : `page:${url}`;
    for (const k of [key, recordKey(key), retriedKey(key)]) {
      if ((await env.cacheGet(k)) === undefined) continue;
      await env.cacheDelete(k);
      removed.push(k);
    }
  }
  env.log(`analyzer: forgot ${removed.length ? removed.join(", ") : "nothing (none of it was cached)"}`);
  return removed;
}

export function bytesFromBase64(b64) {
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

// ---- what the analysis means here ----------------------------------------

// The analyzer's payload "dialect" -> what it means here. A stand-in for the
// debugger's dialect_fit (not in the component yet): resolved wins, "both"
// and "uncertain" mean either, else the text classifier.
export function dialectChoice(payload) {
  const d = payload.dialect;
  if (d.resolved === "client" || d.resolved === "session") {
    return { dialects: [d.resolved], why: `the analyzer resolved it as ${d.resolved}` };
  }
  if (d.resolved === "both") {
    return { dialects: ["session", "client"], why: "the analyzer says it is valid in either dialect" };
  }
  if (d.resolved === "uncertain") {
    return { dialects: ["session", "client"], why: "it mixes client and session references" };
  }
  if (d.classified === "client" || d.classified === "session") {
    return { dialects: [d.classified], why: `the analyzer's text classifier says ${d.classified}` };
  }
  return { dialects: ["session", "client"], why: "the analyzer could not tell" };
}


const LOG = (text) => window.rdbg.log(text);
const DB_NAME = "relevance-debugger";
const STORE = "analyzer";
// Stands in for the glue's import.meta.url, which a blob: module cannot use as
// a base. Never fetched: the fetch intercept below answers every core by name.
const CORE_BASE = "https://relevance-debugger.invalid/";
// How long after the last edit the analysis panel catches up.
const ANALYZE_DELAY_MS = 500;

// ---- IndexedDB -----------------------------------------------------------------

function openDb() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, 1);
    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

async function cacheOp(mode, fn) {
  const db = await openDb();
  try {
    return await new Promise((resolve, reject) => {
      const req = fn(db.transaction(STORE, mode).objectStore(STORE));
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  } finally {
    db.close();
  }
}

const cacheGet = (url) => cacheOp("readonly", (s) => s.get(url)).catch(() => undefined);
const cachePut = (url, value) => cacheOp("readwrite", (s) => s.put(value, url));
const cacheDelete = (url) => cacheOp("readwrite", (s) => s.delete(url));

// ---- running the pieces ----------------------------------------------------

// The cores the glue is served: those of the set being started. A set can be
// started more than once in a page (loadAndStart's retry, Reload the
// analyzer), so the fetch intercept is installed once and reads this.
let servedCores = {};
const realFetch = window.fetch.bind(window);

// The glue fetches each core by URL; hand back the stored bytes instead.
function interceptCores() {
  window.fetch = async (input, init) => {
    const href = typeof input === "string" ? input : input instanceof URL ? input.href : input.url;
    const name = href.split("/").pop();
    if (href.startsWith(CORE_BASE) && Object.hasOwn(servedCores, name)) {
      const bytes = servedCores[name];
      // Gzipped as published, or plain wasm if a server inflated it in transit.
      const gzipped = bytes[0] === 0x1f && bytes[1] === 0x8b;
      const body = gzipped ? new Response(bytes).body.pipeThrough(new DecompressionStream("gzip")) : bytes;
      return new Response(body, { status: 200, headers: { "Content-Type": "application/wasm" } });
    }
    return realFetch(input, init);
  };
}

// Runs a set: throws if it does not start (loadAndStart's safety net).
async function start(pieces) {
  // The editor bundle is a self-contained IIFE.
  new Function(pieces.editor)();
  servedCores = pieces.cores;
  // A component left by an earlier attempt must not pass for this one.
  globalThis.__component = undefined;

  const glue = pieces.glue.split("import.meta.url").join(JSON.stringify(CORE_BASE));
  const blobUrl = URL.createObjectURL(new Blob([glue], { type: "text/javascript" }));
  try {
    await import(blobUrl);
  } finally {
    URL.revokeObjectURL(blobUrl);
  }
  const component = globalThis.__component;
  if (!component) throw new Error("the glue never set globalThis.__component");
  await component.$init;
  return component;
}

// ---- the analysis panel -------------------------------------------------------

function el(tag, text, cls) {
  const node = document.createElement(tag);
  if (text !== undefined) node.textContent = text;
  if (cls) node.className = cls;
  return node;
}

function renderAnalysis(payload) {
  const out = document.getElementById("analysis");
  out.replaceChildren();
  out.className = "";
  const choice = dialectChoice(payload);
  const types = payload.types;
  const typeText = !types ? "n/a"
    : Array.isArray(types.types) ? `${types.types.join(", ")} (${types.plurality})`
    : `unknown (${types.plurality})`;
  const badges = el("p");
  for (const [label, ok] of [
    [`dialect: ${choice.dialects.join(" + ")}`, true],
    [`parse: ${payload.parse.ok ? "ok" : "error"}`, payload.parse.ok],
    [`type: ${typeText}`, types?.ok === true],
    [`cost: ${payload.complexity.evaluation_cost}`, true],
  ]) {
    badges.appendChild(el("span", label, `badge ${ok ? "ok" : "error"}`));
  }
  out.appendChild(badges);
  out.appendChild(el("p", `Dialect: ${choice.why}.`, "hint"));
  if (!payload.parse.ok) {
    const e = payload.parse.error;
    out.appendChild(el("p", `Parse error: ${e.message} (line ${e.line}, column ${e.column})`, "error"));
  }
  const diagnostics = types?.diagnostics ?? [];
  if (diagnostics.length) {
    const table = el("table");
    const head = el("tr");
    for (const h of ["at", "code", "message"]) head.appendChild(el("th", h));
    table.appendChild(head);
    for (const d of diagnostics) {
      const tr = el("tr");
      for (const v of [`${d.line}:${d.column}`, d.code, d.message]) tr.appendChild(el("td", v));
      table.appendChild(tr);
    }
    out.appendChild(table);
  }
  if (payload.unknown_references?.length) {
    out.appendChild(el("p", `Unknown inspectors: ${payload.unknown_references.join(", ")}`, "hint"));
  }
}

// ---- boot --------------------------------------------------------------------

const URLS = (window.RDBG_BUILD && window.RDBG_BUILD.analyzerUrls) || [];
const ENV = {
  fetch: realFetch,
  cacheGet,
  cachePut,
  cacheDelete,
  log: LOG,
  now: () => performance.now(),
  // Missing on plain http (an insecure context): then sha256 is checked in JavaScript.
  subtle: globalThis.crypto && globalThis.crypto.subtle,
  baseUrl: document.baseURI,
};
// Undoes a mounted editor, for Reload the analyzer.
let unmount = null;

async function boot() {
  const started = performance.now();
  const { started: component, how, source } = await loadAndStart(URLS, ENV, start);
  window.rdbg.fact("analyzer source", source);

  const host = document.getElementById("editorHost");
  const editor = window.playgroundEditor.mount(host, {
    doc: window.rdbg.initialText(),
    onRun: () => window.rdbg.evaluate(),
  });
  editor.connect(component.handle);

  // One analysis per distinct text: it renders the panel and the dialect
  // note, and Evaluate reuses it instead of analyzing again.
  let last = { text: null, payload: null };
  const analyze = (text) => {
    if (text !== last.text) {
      last = { text, payload: JSON.parse(component.analyze(text)) };
      renderAnalysis(last.payload);
      window.rdbg.showDialect(dialectChoice(last.payload));
    }
    return last.payload;
  };
  window.rdbg.onAnalyzer(
    { editor, analyze, dialect: (text) => dialectChoice(analyze(text)) },
    `bigfix_relevance_analyzer ${component.version()}, ${how}, ready in ${Math.round(performance.now() - started)} ms`,
  );

  // Analysis is cheap, so it follows the text: half a second after the last
  // change, whatever made it (typing, paste, a completion, a quick fix). The
  // editor bundle exposes no change hook, so watch its DOM.
  let pending = null;
  const observer = new MutationObserver(() => {
    clearTimeout(pending);
    pending = setTimeout(() => analyze(editor.getText().trim()), ANALYZE_DELAY_MS);
  });
  observer.observe(editor.view.contentDOM, { childList: true, characterData: true, subtree: true });
  analyze(editor.getText().trim());
  unmount = () => {
    observer.disconnect();
    clearTimeout(pending);
    editor.view.destroy();
    host.replaceChildren();
  };
}

// The load in progress (boot, or Reload's forget-then-boot), if any. Only one
// runs at a time: two would mount two editors and share servedCores and
// globalThis.__component, so one could fail and record a false "does not
// start".
let booting = null;

function run(steps) {
  booting = steps()
    .catch((err) => {
      // A set recorded as not starting says so itself (and how to retry).
      window.rdbg.onAnalyzerFailed(err.doesNotStart ? err.message : `could not load it: ${err.message || err}`);
    })
    .finally(() => {
      booting = null;
    });
}

const go = () => run(boot);

// Reload the analyzer (Log and diagnostics): forget this browser's copy and
// any "does not start" record, then load and start it again. core.js has
// already put the editor's text back in the plain text box. core.js keeps
// the button disabled while a load runs; a click that comes through anyway
// (after the 5-minute watchdog gave up on a load still running) is ignored,
// and that load reports when it ends.
function reload() {
  if (booting) {
    LOG("analyzer: still loading; Reload ignored until that load ends");
    return;
  }
  if (unmount) unmount();
  unmount = null;
  run(async () => {
    await forgetAnalyzer(URLS, ENV).catch((err) => LOG(`analyzer: could not clear the cache (${err.message || err})`));
    await boot();
  });
}

const problem =
  typeof WebAssembly !== "object" ? "this browser has no WebAssembly"
  : typeof DecompressionStream !== "function" ? "this browser has no DecompressionStream"
  : null;
if (problem) {
  window.rdbg.onAnalyzerFailed(problem);
} else {
  interceptCores();
  window.rdbg.setAnalyzerReload(reload);
  // After the page is usable: Evaluate works while this loads.
  if (document.readyState === "complete") go();
  else window.addEventListener("load", go, { once: true });
}
</script>
